<%- include('partials/header', { title: 'Hand-painted ceramics' }) %>
<script type="application/json" id="products-data"><%- JSON.stringify(products).replace(/</g, '\\u003c') %></script>
<main id="main-content">
  <section class="hero" id="home"><div class="container hero-content">
    <p class="eyebrow">Hand-painted in Puebla, Mexico</p><h1>Made by hand.<br /><em>Meant for home.</em></h1>
    <p class="hero-copy">Colorful Talavera ceramics that carry centuries of artistry from our family to yours.</p>
    <a class="button button-primary" href="#shop">Explore the collection <span aria-hidden="true">→</span></a>
  </div><div class="hero-pattern" aria-hidden="true"></div></section>

  <section class="intro container" id="story"><p class="eyebrow">What is Talavera?</p><div class="intro-grid">
    <h2>From clay to color, made slowly.</h2><div><p>Talavera is a traditional tin-glazed ceramic art form born in Puebla, Mexico. Each piece is shaped, painted, and finished by hand—so no two are ever exactly alike.</p><a class="text-link" href="#process">Learn more →</a></div>
  </div></section>

  <section class="featured"><div class="container"><p class="eyebrow">Featured collection</p><h2>Small details, bright moments.</h2>
    <div class="carousel"><button class="carousel-button previous-button" type="button" aria-label="Previous featured product">←</button>
      <div class="carousel-slides"><% featured.forEach((product, index) => { %>
        <article class="carousel-slide <%= index === 0 ? 'active-slide' : '' %>">
          <div class="carousel-image product-art <%= product.color %>" role="img" aria-label="Placeholder for <%= product.name %>"><span><%= product.placeholder %></span></div>
          <div class="carousel-text"><p class="eyebrow">Featured piece</p><h3><%= product.name %></h3><p><%= product.description %></p><p class="featured-price">$<%= product.price.toFixed(2) %></p><button class="button button-primary add-to-cart" type="button" data-product-id="<%= product.id %>">Add to bag</button></div>
        </article><% }) %></div>
      <button class="carousel-button next-button" type="button" aria-label="Next featured product">→</button>
    </div><p class="carousel-status" aria-live="polite">Showing product 1 of <%= featured.length %></p>
  </div></section>

  <section class="collection" id="shop"><div class="container">
    <div class="section-heading"><div><p class="eyebrow">Shop Talavera</p><h2>Bring color to the everyday.</h2></div><button class="text-link show-all-button" type="button">View all pieces →</button></div>
    <div class="catalog-controls"><label for="product-search">Search the catalog</label><input id="product-search" type="search" placeholder="Try ‘plate’ or ‘planter’" />
      <div class="filter-buttons" aria-label="Filter products by category"><button class="filter-button selected-filter" type="button" data-filter="all" aria-pressed="true">All</button><% ['tableware','planters','serveware','decor'].forEach(category => { %><button class="filter-button" type="button" data-filter="<%= category %>" aria-pressed="false"><%= category[0].toUpperCase() + category.slice(1) %></button><% }) %></div>
    </div>
    <p class="results-count" aria-live="polite"><%= products.length %> pieces</p>
    <div class="product-grid"><% products.forEach(product => { %>
      <article class="product-card" data-category="<%= product.category %>" data-name="<%= product.name.toLowerCase() %>">
        <div class="product-image product-art <%= product.color %>" role="img" aria-label="Placeholder for <%= product.name %>"><span><%= product.placeholder %></span></div>
        <div class="product-info"><div><p class="product-category"><%= product.categoryName %></p><h3><a class="product-detail-link" href="/products/<%= product.id %>"><%= product.name %></a></h3><p class="product-description"><%= product.description %></p></div><p class="product-price">$<%= product.price.toFixed(2) %></p></div>
        <button class="button button-outline add-to-cart" type="button" data-product-id="<%= product.id %>">Add to bag</button>
      </article><% }) %></div>
    <p class="no-products" hidden>No products match your search. Try another name or category.</p>
  </div></section>

  <section class="art-section" id="process"><div class="container art-grid"><div class="art-image" role="img" aria-label="Decorative Talavera-inspired pattern"></div><div class="art-copy"><p class="eyebrow">A labor of love</p><h2>Every piece tells a colorful story.</h2><p>Talavera Azul began in Puebla, Mexico. Founded by Saúl Sánchez, whose passion for his culture inspired him to share the beauty and tradition of Talavera pottery with others.</p><a class="button button-outline" href="#contact">Meet our story →</a></div></div></section>

  <section class="newsletter" id="contact"><div class="container newsletter-content"><div><p class="eyebrow">Contact us</p><h2>Let’s talk Talavera.</h2><p>Send us a message with your questions.</p></div>
    <form class="contact-form" id="contact-form"><label for="name">Name</label><input id="name" name="name" type="text" required />
      <label for="email">Email address</label><input id="email" name="email" type="email" required />
      <label for="message">Message</label><textarea id="message" name="message" rows="4" required></textarea>
      <button class="button button-primary" type="submit">Send message</button><p class="form-message" aria-live="polite"></p>
    </form></div></section>
</main>
<%- include('partials/footer') %>
